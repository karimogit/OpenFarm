{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://karimogit.github.io/OpenFarm/schema/companions.schema.json",
  "title": "OpenFarm companion pairs (content/companions.yaml)",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "crops",
      "relation",
      "evidence",
      "reason"
    ],
    "properties": {
      "crops": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "minItems": 2,
        "maxItems": 2
      },
      "relation": {
        "enum": [
          "good",
          "avoid"
        ]
      },
      "evidence": {
        "enum": [
          "research",
          "extension-advice",
          "traditional"
        ]
      },
      "reason": {
        "type": "string"
      },
      "sources": {
        "type": "array",
        "minItems": 1,
        "items": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[a-z0-9-]+$",
              "description": "Key in content/sources.yaml"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "title",
                "url"
              ],
              "properties": {
                "title": {
                  "type": "string"
                },
                "publisher": {
                  "type": "string"
                },
                "url": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https://"
                }
              }
            }
          ]
        }
      }
    },
    "allOf": [
      {
        "if": {
          "properties": {
            "evidence": {
              "enum": [
                "research",
                "extension-advice"
              ]
            }
          }
        },
        "then": {
          "required": [
            "sources"
          ]
        }
      }
    ]
  }
}
