{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://karimogit.github.io/OpenFarm/schema/rotation.schema.json",
  "title": "OpenFarm crop rotation groups and rules (content/rotation.yaml)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "groups",
    "rules"
  ],
  "properties": {
    "groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slug",
          "name",
          "sources"
        ],
        "properties": {
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "families": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z][a-z]+aceae$"
            }
          },
          "crops": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
            }
          },
          "notes": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^[a-z0-9-]+$",
                  "description": "Key in content/sources.yaml"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "title",
                    "url"
                  ],
                  "properties": {
                    "title": {
                      "type": "string"
                    },
                    "publisher": {
                      "type": "string"
                    },
                    "url": {
                      "type": "string",
                      "format": "uri",
                      "pattern": "^https://"
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "reason",
          "sources"
        ],
        "properties": {
          "kind": {
            "enum": [
              "avoid-follow",
              "prefer-follow",
              "gap-years",
              "note"
            ]
          },
          "from": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "to": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "group": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "years": {
            "type": "integer",
            "minimum": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^[a-z0-9-]+$",
                  "description": "Key in content/sources.yaml"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "title",
                    "url"
                  ],
                  "properties": {
                    "title": {
                      "type": "string"
                    },
                    "publisher": {
                      "type": "string"
                    },
                    "url": {
                      "type": "string",
                      "format": "uri",
                      "pattern": "^https://"
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
