{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://karimogit.github.io/OpenFarm/schema/problem.schema.json",
  "title": "OpenFarm pest, disease or disorder (content/problems/<problem>.md)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "slug",
    "name",
    "kind",
    "affects",
    "sources",
    "license"
  ],
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string"
    },
    "scientific_name": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "pest",
        "disease",
        "disorder"
      ]
    },
    "caused_by": {
      "type": "string"
    },
    "affects": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "minItems": 1
    },
    "conditions": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "string",
            "pattern": "^[a-z0-9-]+$",
            "description": "Key in content/sources.yaml"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "title",
              "url"
            ],
            "properties": {
              "title": {
                "type": "string"
              },
              "publisher": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "format": "uri",
                "pattern": "^https://"
              }
            }
          }
        ]
      }
    },
    "license": {
      "enum": [
        "CC-BY-SA-4.0",
        "CC0-1.0"
      ]
    },
    "authors": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "last_reviewed": {
      "type": "string",
      "format": "date"
    }
  }
}
