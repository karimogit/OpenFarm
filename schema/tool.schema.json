{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://karimogit.github.io/OpenFarm/schema/tool.schema.json",
  "title": "OpenFarm garden tool (content/tools/<tool>.md). Body: '## What it's for', '## How to use it', '## Care and maintenance'. No shop or affiliate links.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "slug",
    "name",
    "category",
    "sources",
    "license"
  ],
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string"
    },
    "category": {
      "enum": [
        "digging",
        "weeding",
        "planting",
        "watering",
        "pruning",
        "harvesting",
        "protection",
        "supports",
        "compost",
        "measuring",
        "carrying"
      ],
      "description": "Primary tool group (breadcrumb and default listing). Labels: Digging & soil, Weeding & cultivating, Planting & sowing, Watering & irrigation, Pruning & cutting, Harvesting, Protection & season extension, Supports & structures, Compost & soil health, Measuring & testing, Carrying & storage."
    },
    "commons_file": {
      "type": "string",
      "description": "Wikimedia Commons file name (free licence) without the File: prefix."
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "title",
              "url"
            ],
            "properties": {
              "title": {
                "type": "string"
              },
              "publisher": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "format": "uri",
                "pattern": "^https://"
              }
            }
          }
        ]
      }
    },
    "license": {
      "enum": [
        "CC-BY-SA-4.0"
      ]
    },
    "general": {
      "type": "boolean",
      "description": "If true, the tool page says it is used for most crops, plus any tasks listed."
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Key jobs this general tool is used for, shown on the tool page."
    },
    "categories": {
      "type": "array",
      "items": {
        "enum": [
          "digging",
          "weeding",
          "planting",
          "watering",
          "pruning",
          "harvesting",
          "protection",
          "supports",
          "compost",
          "measuring",
          "carrying"
        ]
      },
      "uniqueItems": true,
      "description": "Additional groups this tool belongs to, besides the primary `category`. Category pages are /tools/<category>/."
    }
  }
}
