{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://karimogit.github.io/OpenFarm/schema/tool.schema.json",
  "title": "OpenFarm garden tool (content/tools/<tool>.md). Body: '## What it's for', '## How to use it', '## Care and maintenance'. No shop or affiliate links.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "slug",
    "name",
    "category",
    "sources",
    "license"
  ],
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string"
    },
    "category": {
      "enum": [
        "digging",
        "weeding",
        "planting",
        "pruning",
        "watering",
        "propagation",
        "harvesting"
      ]
    },
    "commons_file": {
      "type": "string",
      "description": "Wikimedia Commons file name (free licence) without the File: prefix."
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "title",
              "url"
            ],
            "properties": {
              "title": {
                "type": "string"
              },
              "publisher": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "format": "uri",
                "pattern": "^https://"
              }
            }
          }
        ]
      }
    },
    "license": {
      "enum": [
        "CC-BY-SA-4.0"
      ]
    },
    "general": {
      "type": "boolean",
      "description": "If true, the tool page says it is used for most crops, plus any tasks listed."
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Key jobs this general tool is used for, shown on the tool page."
    }
  }
}
