{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://karimogit.github.io/OpenFarm/schema/region.schema.json",
  "title": "OpenFarm climate region (content/regions/<region>.md)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "slug",
    "name",
    "koppen",
    "color",
    "order",
    "similar"
  ],
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "description": "The region page title. No parenthetical extras — put those in subtitle."
    },
    "subtitle": {
      "type": "string",
      "description": "Short qualifier under the name (e.g. wet and dry seasons, boreal, steppe). Not part of the page title."
    },
    "koppen": {
      "type": "array",
      "items": {
        "enum": [
          "Af",
          "Am",
          "Aw",
          "As",
          "BWh",
          "BWk",
          "BSh",
          "BSk",
          "Csa",
          "Csb",
          "Csc",
          "Cwa",
          "Cwb",
          "Cwc",
          "Cfa",
          "Cfb",
          "Cfc",
          "Dsa",
          "Dsb",
          "Dsc",
          "Dsd",
          "Dwa",
          "Dwb",
          "Dwc",
          "Dwd",
          "Dfa",
          "Dfb",
          "Dfc",
          "Dfd",
          "ET",
          "EF"
        ]
      },
      "minItems": 1
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9a-f]{6}$"
    },
    "order": {
      "type": "integer"
    },
    "similar": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "description": "Most similar regions first \u2013 used when a crop has no guide for this region."
    },
    "examples": {
      "type": "array",
      "description": "Example places in this region (shown as 'Common in:' on guides; flags use the country code).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "country": {
            "type": "string",
            "pattern": "^[A-Z]{2}$",
            "description": "ISO 3166-1 alpha-2"
          },
          "note": {
            "type": "string",
            "description": "Short qualifier, e.g. edge or a K\u00f6ppen subclass"
          }
        }
      }
    },
    "commons_file": {
      "type": "string",
      "description": "Wikimedia Commons file name of a representative farmland/garden photo for this region."
    }
  }
}
