{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://karimogit.github.io/OpenFarm/schema/guide.schema.json",
  "title": "OpenFarm growing guide (content/guides/<crop>/<region>.md)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "crop",
    "region",
    "title",
    "koppen",
    "hemisphere",
    "reference_location",
    "calendar",
    "sun",
    "water",
    "confidence",
    "sources",
    "license",
    "authors",
    "last_reviewed"
  ],
  "properties": {
    "crop": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "region": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 5,
      "pattern": "^[^()]+$",
      "description": "Use '<Crop> in <region name> climates'. No parentheses or place lists; example places live on the region."
    },
    "koppen": {
      "type": "array",
      "items": {
        "enum": [
          "Af",
          "Am",
          "Aw",
          "As",
          "BWh",
          "BWk",
          "BSh",
          "BSk",
          "Csa",
          "Csb",
          "Csc",
          "Cwa",
          "Cwb",
          "Cwc",
          "Cfa",
          "Cfb",
          "Cfc",
          "Dsa",
          "Dsb",
          "Dsc",
          "Dsd",
          "Dwa",
          "Dwb",
          "Dwc",
          "Dwd",
          "Dfa",
          "Dfb",
          "Dfc",
          "Dfd",
          "ET",
          "EF"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "hemisphere": {
      "enum": [
        "north",
        "south",
        "any"
      ]
    },
    "reference_location": {
      "type": "string"
    },
    "calendar": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "required": [
        "harvest"
      ],
      "properties": {
        "sow_indoors": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "uniqueItems": true
        },
        "sow_direct": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "uniqueItems": true
        },
        "plant": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "uniqueItems": true
        },
        "prune": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "uniqueItems": true
        },
        "harvest": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "uniqueItems": true
        }
      }
    },
    "days_to_maturity": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": 0
      },
      "minItems": 2,
      "maxItems": 2
    },
    "spacing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "in_row_cm": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          },
          "minItems": 2,
          "maxItems": 2
        },
        "between_rows_cm": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          },
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "sun": {
      "enum": [
        "full",
        "full-partial",
        "partial",
        "shade"
      ]
    },
    "water": {
      "enum": [
        "low",
        "moderate",
        "high"
      ]
    },
    "varieties": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "description": "Variety slugs (content/varieties/<crop>/) suggested for this region."
    },
    "problems": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "description": "Problem slugs (content/problems/) that matter most in this region."
    },
    "seed_saving_note": {
      "type": "string",
      "description": "Region-specific seed-saving timing or tips."
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "uncertainty": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "string",
            "pattern": "^[a-z0-9-]+$",
            "description": "Key in content/sources.yaml"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "title",
              "url"
            ],
            "properties": {
              "title": {
                "type": "string"
              },
              "publisher": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "format": "uri",
                "pattern": "^https://"
              }
            }
          }
        ]
      }
    },
    "license": {
      "const": "CC-BY-SA-4.0"
    },
    "authors": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "last_reviewed": {
      "type": "string",
      "format": "date"
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "uniqueItems": true,
      "description": "Slugs of tools in content/tools/ that are useful for this crop or guide."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "confidence": {
            "enum": [
              "medium",
              "low"
            ]
          }
        }
      },
      "then": {
        "required": [
          "uncertainty"
        ]
      }
    }
  ]
}
