{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://karimogit.github.io/OpenFarm/schema/guide.schema.json",
  "title": "OpenFarm growing guide (YAML frontmatter)",
  "type": "object",
  "additionalProperties": false,
  "required": ["crop", "common_name", "scientific_name", "family", "variant", "title", "koppen", "hemisphere", "reference_location", "calendar", "sun", "water", "confidence", "sources", "license", "authors", "last_reviewed"],
  "$defs": {
    "month": { "type": "integer", "minimum": 1, "maximum": 12 },
    "months": { "type": "array", "items": { "$ref": "#/$defs/month" }, "uniqueItems": true },
    "range": { "type": "array", "items": { "type": "number", "minimum": 0 }, "minItems": 2, "maxItems": 2 },
    "koppen": { "enum": ["Af","Am","Aw","As","BWh","BWk","BSh","BSk","Csa","Csb","Csc","Cwa","Cwb","Cwc","Cfa","Cfb","Cfc","Dsa","Dsb","Dsc","Dsd","Dwa","Dwb","Dwc","Dwd","Dfa","Dfb","Dfc","Dfd","ET","EF"] }
  },
  "properties": {
    "crop": { "type": "string", "pattern": "^[a-z0-9-]+$", "description": "Slug shared by all variants of a crop; must equal the folder name." },
    "common_name": { "type": "string", "minLength": 1 },
    "scientific_name": { "type": "string", "pattern": "^[A-Z][a-z]+ [a-z]+" },
    "family": { "type": "string", "pattern": "^[A-Z][a-z]+aceae$" },
    "variant": { "type": "string", "pattern": "^[a-z0-9-]+$", "description": "Must equal the file name without .md." },
    "title": { "type": "string", "minLength": 5 },
    "koppen": { "type": "array", "items": { "$ref": "#/$defs/koppen" }, "minItems": 1, "uniqueItems": true },
    "hemisphere": { "enum": ["north", "south", "any"], "description": "Hemisphere the month calendar was written for. 'any' = calendar not tied to hemisphere (e.g. dry-season tropics)." },
    "reference_location": { "type": "string", "description": "Where the calendar was checked against, e.g. 'Netherlands / UK lowlands'." },
    "calendar": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "sow_indoors": { "$ref": "#/$defs/months" },
        "sow_direct": { "$ref": "#/$defs/months" },
        "plant": { "$ref": "#/$defs/months", "description": "Set out transplants, tubers, cloves or sets." },
        "harvest": { "$ref": "#/$defs/months" }
      },
      "required": ["harvest"]
    },
    "days_to_maturity": { "$ref": "#/$defs/range" },
    "spacing": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "in_row_cm": { "$ref": "#/$defs/range" }, "between_rows_cm": { "$ref": "#/$defs/range" } }
    },
    "sun": { "enum": ["full", "full-partial", "partial", "shade"] },
    "water": { "enum": ["low", "moderate", "high"] },
    "companions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "good": { "type": "array", "items": { "type": "string" } },
        "avoid": { "type": "array", "items": { "type": "string" } },
        "evidence": { "enum": ["research", "extension-advice", "traditional"], "description": "How well supported the companion claims are." }
      }
    },
    "confidence": { "enum": ["high", "medium", "low"], "description": "Reviewer confidence that the calendar fits the listed climates." },
    "uncertainty": { "type": "string", "description": "Plain-language caveats. Required when confidence is not 'high'." },
    "sources": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["title", "url"],
        "properties": { "title": { "type": "string" }, "publisher": { "type": "string" }, "url": { "type": "string", "format": "uri", "pattern": "^https://" } }
      }
    },
    "license": { "const": "CC-BY-SA-4.0" },
    "authors": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "last_reviewed": { "type": "string", "format": "date" }
  },
  "allOf": [
    { "if": { "properties": { "confidence": { "enum": ["medium", "low"] } } }, "then": { "required": ["uncertainty"] } }
  ]
}
