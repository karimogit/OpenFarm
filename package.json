{
  "name": "openfarm",
  "version": "0.1.0",
  "private": true,
  "description": "Open, git-based, climate-aware crop growing guides.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "validate": "node scripts/validate.js",
    "build:climate": "python3 scripts/build_koppen.py",
    "build": "npm run validate && eleventy && pagefind --site _site",
    "dev": "eleventy --serve",
    "test": "npm run validate && node scripts/test_profile_save.mjs && node scripts/test_sci.mjs && node scripts/test_filters.mjs && node scripts/test_maps.mjs && node scripts/test_country_links.mjs && node scripts/test_contrast.mjs",
    "import:rescue": "node scripts/import_rescue.js",
    "images": "node scripts/fetch_images.js",
    "check:images": "node scripts/check_images.js",
    "places": "node scripts/build_places.js"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.8",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.3.2",
    "leaflet": "^1.9.4",
    "markdown-it": "^15.0.3",
    "pagefind": "^1.6.0"
  }
}
