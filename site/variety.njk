---
layout: base.njk
pagination:
  data: db.varieties
  size: 1
  alias: v
permalink: "/crops/{{ v.crop }}/{{ v.slug }}/"
eleventyComputed:
  title: "{{ v.name }} ({{ v.cropName }})"
  description: "{{ v.name }} – a {{ v.cropName | lower }} variety: traits, seeds and suitable climate regions."
---
{% set crop = db.cropBy[v.crop] %}
{% set crumbs = [{href: "/crops/", label: "Crops"}, {href: "/crops/" + crop.slug + "/", label: crop.name}] %}
{% if v.groupRecord %}{% set crumbs = crumbs.concat([{href: v.groupRecord.url, label: v.groupRecord.name}]) %}{% endif %}
{% set crumbs = crumbs.concat([{label: v.name, current: true}]) %}{% include "crumbs.njk" %}
<div class="layout">

  <article class="col-main" data-pagefind-body>
    <div class="title-row"><h1>{{ v.name }} <small class="muted">{{ crop.name }}</small></h1>
      <span class="title-actions" data-pagefind-ignore>{% set ty = crop.type %}{% include "type-chip.njk" %}<button type="button" class="fav" data-fav="variety:{{ crop.slug }}/{{ v.slug }}" data-label aria-pressed="false">{% set icon = "heart" %}{% include "icon.njk" %} <span>Favourite</span></button>
      <button type="button" class="grow" data-grow="{{ crop.slug }}/{{ v.slug }}">＋ I'm growing this</button></span></div>
    <p class="your-climate-line" data-your-climate-line hidden></p>
    <p class="sci-line">{% if v.sciHtml %}{{ v.sciHtml | safe }}{% endif %}{% if v.category %} · {{ v.category }}{% endif %}{% if v.synonyms %} · also sold as {{ v.synonyms | join(", ") }}{% endif %}</p>
    {% if v.origin == "imported" %}<p class="sci-line">{% if v.wikidata and not v.rescue %}{% set unreviewedKind = "wikidata" %}{% endif %}{% set editFile = v.file %}{% include "unreviewed.njk" %}</p>{% endif %}
    {% set img = v.image %}{% set alt = v.name + " " + crop.name %}{% set inherited = v.imageInherited %}{% include "image.njk" %}
    <div class="body">{{ v.html | safe }}</div>
    {% include "forage-disclaimer.njk" %}
    {% if v.fruit %}<p><strong>Fruit:</strong> {{ v.fruit }}</p>{% endif %}
    {% if v.history %}<p><strong>History:</strong> {{ v.history }}</p>{% endif %}

    {% if v.groupRecord %}<p><strong>Group:</strong> <a href="{{ v.groupRecord.url | url }}">{{ v.groupRecord.name }}</a></p>{% endif %}
    {% if v.guides and v.guides.length %}
    <h2>Variety-specific guides</h2>
    <p>{% for g in v.guides %}<a class="chip" href="{{ g.url | url }}"><span class="swatch sm" style="background:{{ g.regionColor }}"></span>{{ g.regionName }}</a> {% endfor %}</p>
    {% endif %}


    <h2>Climate regions</h2>
    {% if v.suitable_regions and v.suitable_regions.length %}
      <p>{% for r in v.suitable_regions %}{% set reg = db.regionBy[r] %}<a class="chip" href="{{ ('/regions/' + r + '/') | url }}"><span class="swatch sm" style="background:{{ reg.color }}"></span>{{ reg.name }}</a> {% endfor %}</p>
      {% if v.regions_note %}<p class="small">{{ v.regions_note }}</p>{% endif %}
    {% else %}
      <div class="no-guide">
        {% if crop.guides.length %}
        <p>No source names climate regions for this variety itself yet. These {{ crop.name | lower }} guides cover the crop in general:</p>
        <p>{% for g in crop.guides %}<a class="chip" href="{{ g.url | url }}"><span class="swatch sm" style="background:{{ g.regionColor }}"></span>{{ g.regionName }}</a> {% endfor %}</p>
        {% else %}
        <p>There is no {{ crop.name | lower }} guide for any climate region yet, so here are the general facts for the crop:</p>
        {% endif %}
        <dl class="kv compact">
          {% if v.days_to_maturity %}<div><dt>Days to maturity</dt><dd>{{ v.days_to_maturity | range(" days") }}</dd></div>{% elif crop.days_to_first_harvest %}<div><dt>To first harvest</dt><dd>{{ crop.days_to_first_harvest | range(" days") }}</dd></div>{% endif %}
          {% if crop.sowing_method %}<div class="wide"><dt>Sowing</dt><dd>{{ crop.sowing_method }}</dd></div>{% endif %}
          {% if crop.size and crop.size.spread_cm %}<div><dt>Spacing (spread)</dt><dd>{{ crop.size.spread_cm }} cm</dd></div>{% endif %}
          {% if crop.size and crop.size.row_spacing_cm %}<div><dt>Row spacing</dt><dd>{{ crop.size.row_spacing_cm }} cm</dd></div>{% endif %}
          {% if crop.temperature and crop.temperature.frost_tender %}<div><dt>Frost</dt><dd>Frost-tender</dd></div>{% endif %}
          {% if crop.sun %}<div><dt>Sun</dt><dd>{{ crop.sun | label }}</dd></div>{% endif %}
        </dl>
        <p class="small" data-your-region-variety data-crop="{{ crop.slug }}"></p>
        <p class="small">Grow it somewhere? <a href="{{ '/contribute/' | url }}#guides">Write a {{ crop.name | lower }} guide for your climate region</a> – with sources, so others can trust it.</p>
      </div>
    {% endif %}
    {% set used = crop.guides | whereIn("varieties", v.slug) %}
    {% if used.length %}<p>Suggested in: {% for g in used %}<a href="{{ g.url | url }}">{{ g.title }}</a>{% if not loop.last %}, {% endif %}{% endfor %}</p>{% endif %}

    {% if v.disease_resistance and v.disease_resistance.length %}<h2>Disease resistance</h2><p>{{ v.disease_resistance | join(", ") }}</p>{% endif %}
    {% if v.disease_note %}<p class="small">{{ v.disease_note }}</p>{% endif %}

    <h2>Sources</h2>
    {% set srcs = v.sources %}{% include "sources.njk" %}
    <p class="meta">License {{ v.license }}</p>
    {% set editFile = v.file %}{% include "edited-by.njk" %}
    {% set editLabel = "Edit this variety" %}{% include "edit-button.njk" %}
  </article>
  <aside class="col-side">
    {% include "your-climate.njk" %}
    {% set hz = v.hardiness or crop.hardiness %}{% set annual = crop.lifecycle == "annual" %}{% include "hardiness.njk" %}
    <section class="side-card">
      <h3>Traits</h3>
      <dl class="kv">
        {% if v.growth_habit %}<div><dt>Growth habit</dt><dd>{{ v.growth_habit | label }}</dd></div>{% endif %}
        {% if v.days_to_maturity %}<div><dt>Days to maturity</dt><dd>{{ v.days_to_maturity | range("") }}{% if v.days_from %} from {{ v.days_from }}{% endif %}</dd></div>{% endif %}
        {% if v.cold_tolerance %}<div><dt>Cold tolerance</dt><dd>{{ v.cold_tolerance | label }}</dd></div>{% endif %}
        {% if v.heat_tolerance %}<div><dt>Heat tolerance</dt><dd>{{ v.heat_tolerance | label }}</dd></div>{% endif %}
        {% if v.chill_hours %}<div><dt>Chill hours</dt><dd>{{ v.chill_hours | range(" h") }}</dd></div>{% endif %}
        {% if v.pollination_partners %}<div><dt>Pollinated by</dt><dd>{% for p in v.pollination_partners %}<a href="{{ ('/crops/' + v.crop + '/' + p + '/') | url }}">{{ p | replace("-", " ") | title }}</a>{% if not loop.last %}, {% endif %}{% endfor %}</dd></div>{% endif %}
        {% if v.sun %}<div><dt>Sun</dt><dd>{{ v.sun | label }}</dd></div>{% endif %}
        {% if v.size and v.size.height_cm %}<div><dt>Height</dt><dd>{{ v.size.height_cm }} cm</dd></div>{% endif %}
        {% if v.size and v.size.spread_cm %}<div><dt>Spread</dt><dd>{{ v.size.spread_cm }} cm</dd></div>{% endif %}
      </dl>
      {% if v.cold_note %}<p class="small">{{ v.cold_note }}</p>{% endif %}
      {% if v.pollination_note %}<p class="small">{{ v.pollination_note }}</p>{% endif %}
      {% if v.harvest_note %}<p class="small">{{ v.harvest_note }}</p>{% endif %}
    </section>
    <section class="side-card">
      <h3>Seeds</h3>
      {% set ss = crop.seed_saving %}{% set vs = v.seeds %}{% set simg = crop.seedImage %}{% include "seeds.njk" %}
      {% if not v.seeds %}<p class="small muted">Variety seed type not recorded; values shown are for the crop.</p>{% endif %}
    </section>
    {% include "weather.njk" %}
  </aside>
</div>
