---
layout: base.njk
pagination:
  data: db.tools
  size: 1
  alias: t
permalink: "/tools/{{ t.slug }}/"
eleventyComputed:
  title: "{{ t.name }}"
---
<p class="crumbs"><a href="{{ '/tools/' | url }}">Tools</a> /</p>
<div class="layout">
<article class="col-main" data-pagefind-body>
  <h1>{{ t.name }}</h1>
  <p class="sci-line">{{ t.category | capitalize }}</p>
  {% if t.image %}{% set img = t.image %}{% set alt = t.name %}{% set inherited = false %}{% include "image.njk" %}{% endif %}
  <div class="body">{{ t.html | safe }}</div>
  <h2>Sources</h2>
  {% set srcs = t.sources %}{% include "sources.njk" %}
  {% set editFile = t.file %}{% set editLabel = "Edit this tool" %}{% include "edit-button.njk" %}
</article>
<aside class="col-side">
  {% if t.crops.length or t.guides.length %}<section class="side-card"><h3>Used in</h3>
    <ul class="guide-list">{% for c in t.crops %}<li><a href="{{ ('/crops/' + c.slug + '/') | url }}">{{ c.name }}</a></li>{% endfor %}
    {% for g in t.guides %}{% if loop.index <= 12 %}<li><a href="{{ g.url | url }}">{{ g.cropName }} – {{ g.regionName }}</a></li>{% endif %}{% endfor %}</ul>
  </section>{% endif %}
  <p class="small"><a href="{{ '/api/tools.json' | url }}">All tools as JSON</a></p>
</aside>
</div>
