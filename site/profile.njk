---
layout: base.njk
title: My Profile
permalink: /profile/
pageScripts: [profile.js]
---
<div data-pagefind-ignore>
<h1>My Profile</h1>

<div class="layout">
  <div class="col-main">
    <section class="card" id="growing">
      <div class="section-head">
        <h2>What I'm growing</h2>
        <button type="button" id="add-growing-btn" class="button">{% set icon = "plus" %}{% include "icon.njk" %} Add</button>
      </div>
      <div id="growing-list"></div>
    </section>

    <dialog id="grow-search" class="dialog" aria-labelledby="grow-search-title">
      <div class="dialog-head">
        <h2 id="grow-search-title">Add a crop or variety</h2>
        <button type="button" class="dialog-close" data-dialog-close aria-label="Close">{% set icon = "x" %}{% include "icon.njk" %}</button>
      </div>
      <label class="visually-hidden" for="grow-search-q">Search crops and varieties</label>
      <input id="grow-search-q" type="search" placeholder="Search crops and varieties" autocomplete="off">
      <ul id="grow-search-results" role="listbox" aria-label="Matching crops and varieties"></ul>
    </dialog>

    <dialog id="grow-edit" class="dialog" aria-labelledby="grow-edit-title">
      <div class="dialog-head">
        <h2 id="grow-edit-title">Edit</h2>
        <button type="button" class="dialog-close" data-dialog-close aria-label="Close">{% set icon = "x" %}{% include "icon.njk" %}</button>
      </div>
      <form id="grow-edit-form" class="grow-form">
        <p class="grow-edit-lead" id="grow-edit-lead"></p>
        <label>Variety
          <select name="variety" id="grow-variety"><option value="">–</option></select>
        </label>
        <div class="grow-dates">
          <label>Sow date <input type="date" name="sown" id="grow-sown"></label>
          <label>Plant date <input type="date" name="planted" id="grow-planted"></label>
        </div>
        <label>Location or bed <input type="text" name="bed" id="grow-bed" maxlength="200" placeholder="e.g. Bed 3, greenhouse"></label>
        <label>Quantity <input type="text" name="quantity" id="grow-quantity" maxlength="80" placeholder="e.g. 12 plants, 2 rows"></label>
        <fieldset class="grow-status">
          <legend>Status</legend>
          <label><input type="radio" name="status" value="planned"> Planned</label>
          <label><input type="radio" name="status" value="sown"> Sown</label>
          <label><input type="radio" name="status" value="growing"> Growing</label>
          <label><input type="radio" name="status" value="harvested"> Harvested</label>
        </fieldset>
        <label class="notes">Notes
          <textarea name="notes" id="grow-notes" rows="4" maxlength="5000" placeholder="Source of seed, how it went…"></textarea>
        </label>
        <p class="dialog-actions">
          <button type="button" class="danger" id="grow-remove">Remove</button>
        </p>
      </form>
    </dialog>

    <section class="card">
      <h2>Favourites</h2>
      <div id="fav-list"></div>
    </section>

    <section class="card">
      <h2>Guides for my climate region</h2>
      <div id="profile-guides"></div>
    </section>
  </div>

  <aside class="col-side">
    {% include "your-climate.njk" %}
    <section class="side-card">
      <h3>My location</h3>
      <div id="profile-location"></div>
    </section>
    {% include "weather.njk" %}
    <section class="side-card" id="calendar">
      <h3>Reminders in my calendar</h3>
      <p class="small">Download your sowing, planting and harvest windows for the crops you grow as a calendar file (.ics).
        Open it on your phone or computer – your calendar app then reminds you even when this site is closed.</p>
      <p><button type="button" id="ics-btn">Export to calendar (.ics)</button></p>
      <p class="credit">Generated in this browser from your growing list and your climate region's guides. Re-export after you add crops.</p>
    </section>
    <section class="side-card">
      <h3>My data</h3>
      <div class="export-menu">
        <div class="drop" data-export-drop>
          <button type="button" id="export-btn" aria-haspopup="menu" aria-expanded="false" aria-controls="export-menu">Export</button>
          <ul id="export-menu" class="menu" role="menu" hidden>
            <li role="none"><button type="button" role="menuitem" data-export="json">JSON backup</button></li>
            <li role="none"><button type="button" role="menuitem" data-export="csv">CSV</button></li>
            <li role="none"><button type="button" role="menuitem" data-export="ics">Calendar (.ics)</button></li>
            <li role="none"><button type="button" role="menuitem" data-export="md">Markdown</button></li>
          </ul>
        </div>
        <p class="row">
          <label class="button secondary file-btn">Import JSON backup<input type="file" id="import-file" accept="application/json,.json" class="visually-hidden"></label></p>
        <p class="small muted">Stored only in this browser — nothing is sent to a server. See <a href="{{ '/help/' | url }}#profile">Help</a> for details.</p>
      </div>
      <p id="import-msg" class="small" role="status"></p>
      <p><button type="button" id="clear-data" class="danger">Clear my data</button></p>
      <p class="credit">Format: versioned JSON (version {{ 1 }}). Stored in this browser's localStorage under <code>openfarm.profile</code>.</p>
    </section>
  </aside>
</div>
</div>
<script id="of-catalog" type="application/json">{{ db.catalog | json | safe }}</script>
