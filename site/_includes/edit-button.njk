{# expects `editFile` and `editLabel`: the one edit call-to-action at the bottom of a page #}
<p class="edit-cta" id="edit" data-pagefind-ignore><a class="button" href="{{ site.repo }}/edit/{{ site.branch }}/{{ editFile }}">{{ editLabel }}</a>
  <span class="small muted">Every page is a plain text file on GitHub – <a href="{{ site.repo }}/blob/{{ site.branch }}/CONTRIBUTING.md">how to contribute</a>.</span></p>
