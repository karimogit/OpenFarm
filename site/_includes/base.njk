<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} · {% endif %}{{ site.name }}</title>
  <meta name="description" content="{{ description or site.short }}">
  <link rel="icon" href="{{ '/assets/favicon.svg' | url }}">
  <link rel="stylesheet" href="{{ '/assets/css/style.css' | url }}">
  {% if jsonUrl %}<link rel="alternate" type="application/json" href="{{ jsonUrl | url }}">{% endif %}
</head>
<body{% if bodyClass %} class="{{ bodyClass }}"{% endif %}>
  <header class="top">
    <a class="brand" href="{{ '/' | url }}">{% set icon = "sprout" %}{% include "icon.njk" %} <strong>OpenFarm</strong></a>
    <form class="top-search" action="{{ '/search/' | url }}" role="search">
      <input type="search" name="q" placeholder="Search crops, guides, regions…" aria-label="Search OpenFarm">
    </form>
    {%- set u = page.url or "" -%}
    {%- set sect = "home" if u == "/" else ("crops" if (u.indexOf("/crops/") == 0 or u.indexOf("/guides/") == 0 or u.indexOf("/problems/") == 0) else ("regions" if u.indexOf("/regions/") == 0 else ("tools" if u.indexOf("/tools/") == 0 else ("profile" if u.indexOf("/profile/") == 0 else ("help" if u.indexOf("/help/") == 0 else ("about" if u.indexOf("/contribute/") == 0 else "")))))) %}
    <nav class="main-nav" aria-label="Main">
      <a href="{{ '/' | url }}#where"{% if sect == "home" %} aria-current="page"{% endif %}>Find guides</a>

      <div class="nav-drop" data-nav-drop>
        <a class="nav-drop-label" href="{{ '/crops/' | url }}"{% if sect == "crops" %} aria-current="page"{% endif %}>Crops</a>
        <button type="button" class="nav-drop-btn" aria-expanded="false" aria-haspopup="true" aria-controls="nav-crops" aria-label="Open crops menu">{% set icon = "chevron-down" %}{% include "icon.njk" %}</button>
        <ul id="nav-crops" class="nav-menu" role="menu" hidden>
          <li role="none"><a role="menuitem" href="{{ '/crops/' | url }}"{% if u == "/crops/" %} aria-current="page"{% endif %}>All crops</a></li>
          {% for t in db.types %}
          <li role="none"><a role="menuitem" href="{{ ('/crops/type/' + t.slug + '/') | url }}"{% if u == "/crops/type/" + t.slug + "/" %} aria-current="page"{% endif %}>{{ t.label }}</a></li>
          {% endfor %}
        </ul>
      </div>

      <div class="nav-drop" data-nav-drop>
        <a class="nav-drop-label" href="{{ '/regions/' | url }}"{% if sect == "regions" %} aria-current="page"{% endif %}>Region</a>
        <button type="button" class="nav-drop-btn" aria-expanded="false" aria-haspopup="true" aria-controls="nav-regions" aria-label="Open regions menu">{% set icon = "chevron-down" %}{% include "icon.njk" %}</button>
        <ul id="nav-regions" class="nav-menu" role="menu" hidden>
          <li role="none"><a role="menuitem" href="{{ '/regions/' | url }}"{% if u == "/regions/" %} aria-current="page"{% endif %}>All regions</a></li>
          {% for r in db.regions %}
          <li role="none"><a role="menuitem" href="{{ ('/regions/' + r.slug + '/') | url }}"{% if u == "/regions/" + r.slug + "/" %} aria-current="page"{% endif %}><span class="swatch sm" style="background:{{ r.color }}"></span>{{ r.name }}</a></li>
          {% endfor %}
        </ul>
      </div>

      <a href="{{ '/tools/' | url }}"{% if sect == "tools" %} aria-current="page"{% endif %}>Tools</a>
      <a href="{{ '/help/' | url }}"{% if sect == "help" %} aria-current="page"{% endif %}>Help</a>
      <a href="{{ '/contribute/' | url }}"{% if sect == "about" %} aria-current="page"{% endif %}>About</a>
    </nav>
    <div class="top-icons">
      <button type="button" class="icon-btn bell" data-bell aria-haspopup="dialog" aria-expanded="false" aria-controls="bell-panel" title="Reminders">
        {% set icon = "bell" %}{% include "icon.njk" %}<span class="visually-hidden">Reminders</span><span class="count" data-bell-count hidden></span></button>
      <div id="bell-panel" class="bell-panel" role="dialog" aria-label="Reminders" hidden></div>
      <a class="icon-btn profile-icon" href="{{ '/profile/' | url }}"{% if sect == "profile" %} aria-current="page"{% endif %} title="My Profile">
        {% set icon = "user" %}{% include "icon.njk" %}<span class="visually-hidden">My Profile</span><span class="dot" data-profile-dot hidden></span></a>
    </div>
  </header>
  <main>
    {{ content | safe }}
  </main>
  <div id="save-status" class="save-status" role="status" aria-live="polite" aria-atomic="true" hidden></div>
  <footer class="foot">
    <p><a href="{{ '/contribute/' | url }}">About</a> · <a href="{{ '/help/' | url }}">Help</a> · <a href="{{ '/crops/' | url }}#seed-sources">Seed sources</a> · <a href="{{ site.repo }}">GitHub</a>
      · © {{ site.attribution }} · <a href="{{ site.repo }}/blob/main/LICENSE">MIT</a> · content <a href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a></p>
  </footer>
  <script id="of-index" type="application/json">{{ db.clientIndex | json | safe }}</script>
  <script id="of-koppen" type="application/json">{{ koppen | json | safe }}</script>
  <script>window.OPENFARM_BASE = "{{ '/' | url }}"; window.OPENFARM_REPO = "{{ site.repo }}";</script>
  <script type="module" src="{{ '/assets/js/icons.js' | url }}"></script>
  <script type="module" src="{{ '/assets/js/common.js' | url }}"></script>
  {% for s in pageScripts %}<script type="module" src="{{ ('/assets/js/' + s) | url }}"></script>{% endfor %}
</body>
</html>
