<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} · {% endif %}{{ site.name }}</title>
  <meta name="description" content="{{ description or site.tagline }}">
  <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🌱</text></svg>">
  <link rel="stylesheet" href="{{ '/assets/css/style.css' | url }}">
</head>
<body>
  <header class="top">
    <a class="brand" href="{{ '/' | url }}">🌱 <strong>OpenFarm</strong></a>
    <nav>
      <a href="{{ '/' | url }}#where">Find guides</a>
      <a href="{{ '/crops/' | url }}">Crops</a>
      <a href="{{ '/contribute/' | url }}">Contribute</a>
      <a href="{{ site.repo }}">GitHub</a>
    </nav>
  </header>
  <main>
    {{ content | safe }}
  </main>
  <footer class="foot">
    <p>Guide content is <a href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a> · Code is <a href="{{ site.repo }}/blob/main/LICENSE">MIT</a> ·
      Climate data: <a href="https://www.gloh2o.org/koppen/">Beck et al. (2018)</a>, CC BY 4.0 · Map © <a href="https://www.openstreetmap.org/copyright">OpenStreetMap contributors</a></p>
    <p>A community revival in the spirit of the original <a href="https://github.com/openfarmcc">OpenFarm</a>. Always check local advice – climates vary at small scales.</p>
  </footer>
</body>
</html>
