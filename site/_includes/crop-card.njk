{# expects `c` (crop) – photo and names; type shown as a left-edge accent on mixed lists only.
   Extra labels (.xlabel) are hidden unless the visitor turns them on in the Filters panel.
   Type chips and the Unreviewed badge are not shown on cards (the badge stays on the crop page). #}
<li class="t-{{ c.type }}" data-name="{{ c.name | lower }} {{ c.scientific_name | lower }} {{ c.family | lower }}" data-guides="{{ c.guides.length }}" data-reviewed="{{ '0' if c.origin == 'imported' else '1' }}" data-life="{% if c.lifecycle %}{{ c.lifecycle }}{% elif c.perennial or c.type in ['fruit-tree','nut','berry'] %}perennial{% endif %}"><a href="{{ ('/crops/' + c.slug + '/') | url }}">
  {% if c.image %}<span class="thumb"><img src="{{ c.image | wmThumb(250) }}" srcset="{{ c.image | wmSrcset(250) }}" alt="" loading="lazy" style="max-width:{{ c.image.orig_width or 250 }}px;max-height:{{ c.image.orig_height or 250 }}px"></span>{% else %}<span class="thumb none">{% set icon = "sprout" %}{% include "icon.njk" %}</span>{% endif %}
  <strong class="name">{{ c.name }}</strong><em class="sci1">{% if c.scientific_name %}{{ c.scientific_name }}{% else %}&nbsp;{% endif %}</em>
  <span class="badges">
    {% if c.guides.length %}<span class="badge guide xlabel">{{ c.guides.length }} guide{% if c.guides.length > 1 %}s{% endif %}</span>{% endif %}
    {% if c.varieties.length %}<span class="badge xlabel">{{ c.varieties.length }} variet{% if c.varieties.length > 1 %}ies{% else %}y{% endif %}</span>{% endif %}
    {% if c.lifecycle %}<span class="badge xlabel">{{ c.lifecycle }}</span>{% endif %}{% if c.edible == true %}<span class="badge xlabel">edible{% if c.edible_parts and c.edible_parts.length %} · {{ c.edible_parts[0] }}{% endif %}</span>{% endif %}
    {% if c.hardiness %}<span class="badge xlabel" title="USDA hardiness zones">zones {{ c.hardiness.min }}–{{ c.hardiness.max }}</span>{% endif %}</span>
</a><button class="fav card-fav" type="button" data-fav="crop:{{ c.slug }}" aria-pressed="false" title="Add to favourites">{% set icon = "heart" %}{% include "icon.njk" %}<span class="visually-hidden">Add to favourites</span></button></li>
