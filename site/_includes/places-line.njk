{# Expects `places` (array of {name, country?, note?}) and optional `lead` (default "Common in:"). Flags only next to places, never on the region name. The country (with flag) links to its country page. #}
{% if places and places.length %}<p class="places-line small muted">{% if lead %}{{ lead }} {% else %}Common in: {% endif %}{% for p in places %}{% set cc = p.country %}{% include "country-link.njk" %}{% if p.name %} {{ p.name }}{% endif %}{% if p.note %} ({{ p.note }}){% endif %}{% if not loop.last %}<span class="place-sep">,</span> {% endif %}{% endfor %}</p>{% endif %}
