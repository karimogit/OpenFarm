{# Filters & labels panel for card lists; choices are remembered in this browser (localStorage "openfarm.ui"). #}
<details class="filters" data-filters data-pagefind-ignore>
  <summary>Filters &amp; labels</summary>
  <fieldset><legend>Show labels</legend>
    <label><input type="checkbox" data-ui="labels"> Extra labels on cards (guides, varieties, annual/perennial, hardiness zones, Köppen codes)</label>
  </fieldset>
  <fieldset><legend>Only show</legend>
    <label><input type="checkbox" data-ui="withGuide"> Crops with a climate guide</label>
    <label><input type="checkbox" data-ui="reviewed"> Reviewed crops</label>
    <label><input type="checkbox" data-ui="perennial"> Perennials</label>
    <label><input type="checkbox" data-ui="edible"> Edible plants</label>
    <label><input type="checkbox" data-ui="flowers"> Flowers</label>
  </fieldset>
  <p class="small"><button type="button" class="small secondary" data-ui-reset>Reset</button> <span class="muted" data-ui-count></span></p>
</details>
