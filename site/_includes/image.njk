{# expects `img` (image record or null), `alt` and optional `inherited`. Heroes stay eager (above the fold). #}
{% if img %}
<figure class="photo">
  <div class="frame"><img src="{{ img | wmThumb(500) }}" srcset="{{ img | wmSrcsetWidths }}" sizes="(max-width: 600px) 100vw, 500px" alt="{{ alt }}"{% if img.orig_width %} width="{{ img.orig_width }}" height="{{ img.orig_height }}"{% endif %}></div>
  <figcaption>{% if img.note %}<strong>{{ img.note }}.</strong> {% endif %}{% if inherited %}Crop photo (no variety photo yet). {% endif %}Photo: {{ img.author | truncate(60) }} ·
    {% if img.license_url %}<a href="{{ img.license_url }}">{{ img.license }}</a>{% else %}{{ img.license }}{% endif %} ·
    <a href="{{ img.source }}">Wikimedia Commons</a></figcaption>
</figure>
{% else %}
<div class="photo photo-empty">No free photo yet – <a href="https://commons.wikimedia.org/">add one on Wikimedia Commons</a>, then set <code>commons_file</code>.</div>
{% endif %}
