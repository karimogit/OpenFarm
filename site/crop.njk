---
layout: base.njk
pagination:
  data: db.crops
  size: 1
  alias: crop
permalink: "/crops/{{ crop.slug }}/"
eleventyComputed:
  title: "{{ crop.name }}"
  description: "{{ crop.name }}{% if crop.scientific_name %} ({{ crop.scientific_name }}){% endif %}: general growing facts, varieties and climate-region guides."
  jsonUrl: "/crops/{{ crop.slug }}.json"
---
{% set crumbs = [{href: "/crops/", label: "Crops"}, {href: "/crops/type/" + crop.type + "/", label: db.typeLabels[crop.type]}, {label: crop.name, current: true}] %}{% include "crumbs.njk" %}
<div class="layout">
  <article class="col-main" data-pagefind-body>
    <div class="title-row"><h1>{{ crop.name }} {% if crop.scientific_name %}<em class="sci">{{ crop.scientific_name }}</em>{% endif %}</h1>
      <span class="title-actions" data-pagefind-ignore>{% set ty = crop.type %}{% include "type-chip.njk" %}<button type="button" class="fav" data-fav="crop:{{ crop.slug }}" data-label aria-pressed="false">{% set icon = "heart" %}{% include "icon.njk" %} <span>Favourite</span></button>
      <button type="button" class="grow" data-grow="{{ crop.slug }}">＋ I'm growing this</button></span></div>
    <p class="your-climate-line" data-your-climate-line hidden></p>
    {% if crop.hardiness %}<p class="hz-range"><strong>Hardiness:</strong> USDA zones {{ crop.hardiness.min }}–{{ crop.hardiness.max }}{% if crop.lifecycle == "annual" %} <span class="small muted">(as a perennial; usually grown as an annual)</span>{% endif %}</p>{% endif %}
    <p class="sci-line">{% if crop.family %}{{ crop.family }}{% endif %}{% if crop.lifecycle %} · {{ crop.lifecycle | label }}{% endif %}{% if crop.aliases %} · also called {{ crop.aliases | join(", ") }}{% endif %}
      {% if crop.origin == "imported" %} · {% set editFile = crop.file %}{% include "unreviewed.njk" %}{% endif %}</p>
    {% set img = crop.image %}{% set alt = crop.name %}{% set inherited = false %}{% include "image.njk" %}
    <div class="body">{{ crop.html | safe }}</div>
    {% include "forage-disclaimer.njk" %}
    {% if crop.toolList.length %}<p class="small"><strong>Useful tools:</strong> {% for x in crop.toolList %}<a class="chip" href="{{ x.url | url }}">{{ x.name }}</a> {% endfor %}</p>{% endif %}

    <section class="your-region card" data-your-region data-crop="{{ crop.slug }}" data-crop-name="{{ crop.name }}" data-pagefind-ignore hidden></section>

    <div data-guides data-crop="{{ crop.slug }}">
    <h2 id="guides">Growing guides by climate region</h2>
    {% if crop.guides.length %}
      {% for g in crop.guides %}
      <section class="card guide-card match" data-guide-region="{{ g.region }}">
        <a class="match-thumb" href="{{ g.url | url }}" tabindex="-1" aria-hidden="true">{% if crop.image %}<span class="thumb"><img src="{{ crop.image | wmThumb(250) }}" srcset="{{ crop.image | wmSrcset(250) }}" alt="" loading="lazy"></span>{% else %}<span class="thumb none">🌱</span>{% endif %}</a>
        <div class="match-body">
        <h3><span class="swatch sm" style="background:{{ g.regionColor }}"></span><a href="{{ g.url | url }}">{{ g.regionName }}</a> <small>{{ g.title }}</small></h3>
        <p>{% for k in g.koppen %}{{ k | kgLink(koppen.classes, db.kgToRegion) | safe }}{% endfor %} · checked against {{ g.reference_location }}</p>
        {% set cal = g.calendar %}{% include "calendar.njk" %}
        </div>
      </section>
      {% endfor %}
    {% else %}
      <p>No climate guides yet. The facts on this page apply everywhere; the timing depends on your climate region.</p>
    {% endif %}
    </div>

    {% if crop.groups.length or crop.varieties.length %}
    <h2 id="varieties">Varieties <small>({{ crop.varieties.length }})</small></h2>
    {% if crop.groups.length %}
      {% for g in crop.groups %}
      <h3><a href="{{ g.url | url }}">{{ g.name }}</a> <small>({{ g.members.length }})</small></h3>
      {% if g.members.length %}
      <ul class="variety-grid">
        {% for v in g.members %}
        <li><a href="{{ v.url | url }}"><strong>{{ v.name }}</strong>
          {% if v.sciHtml %}<span class="sci1">{{ v.sciHtml | safe }}</span>{% endif %}
          <span>{% if v.category %}{{ v.category }}{% endif %}{% if v.days_to_maturity %} · {{ v.days_to_maturity | range(" days") }}{% endif %}{% if v.seeds %} · {{ v.seeds.type | label }}{% endif %}</span></a></li>
        {% endfor %}
      </ul>
      {% else %}
      <p class="small"><a href="{{ g.url | url }}">About this group</a></p>
      {% endif %}
      {% endfor %}
      {% set ungrouped = crop.varieties | rejectattr("group") %}
      {% if ungrouped.length %}
      <h3>Other varieties</h3>
      <ul class="variety-grid">
        {% for v in ungrouped %}
        <li><a href="{{ v.url | url }}"><strong>{{ v.name }}</strong>
          {% if v.sciHtml %}<span class="sci1">{{ v.sciHtml | safe }}</span>{% endif %}
          <span>{% if v.category %}{{ v.category }}{% endif %}{% if v.days_to_maturity %} · {{ v.days_to_maturity | range(" days") }}{% endif %}{% if v.seeds %} · {{ v.seeds.type | label }}{% endif %}</span></a></li>
        {% endfor %}
      </ul>
      {% endif %}
    {% else %}
      <ul class="variety-grid">
        {% for v in crop.varieties %}
        <li><a href="{{ v.url | url }}"><strong>{{ v.name }}</strong>
          {% if v.sciHtml %}<span class="sci1">{{ v.sciHtml | safe }}</span>{% endif %}
          <span>{% if v.category %}{{ v.category }}{% endif %}{% if v.days_to_maturity %} · {{ v.days_to_maturity | range(" days") }}{% endif %}{% if v.seeds %} · {{ v.seeds.type | label }}{% endif %}</span></a></li>
        {% endfor %}
      </ul>
    {% endif %}
    {% endif %}

    {% if crop.problemList.length %}
    <h2 id="problems">Pests, diseases and disorders</h2>
    <ul>{% for p in crop.problemList %}<li><a href="{{ ('/problems/' + p.slug + '/') | url }}">{{ p.name }}</a> <small class="muted">{{ p.kind }}</small></li>{% endfor %}</ul>
    {% endif %}

    {% include "rotation.njk" %}

    <h2>Sources</h2>
    {% set srcs = crop.sources %}{% include "sources.njk" %}
    <p class="meta">{% if crop.origin == "curated" %}By {{ crop.authors | join(", ") }} · last reviewed {{ crop.last_reviewed }} · {% endif %}
      License {{ crop.license }} · <a href="{{ ('/crops/' + crop.slug + '.json') | url }}">JSON</a></p>
    {% set editFile = crop.file %}{% include "edited-by.njk" %}
    {% set editLabel = "Edit this crop" %}{% include "edit-button.njk" %}
  </article>

  <aside class="col-side">
    {% include "your-climate.njk" %}
    {% set hz = crop.hardiness %}{% set annual = crop.lifecycle == "annual" %}{% include "hardiness.njk" %}
    <section class="side-card" id="facts">
      <h3>Quick facts</h3>
      <dl class="kv">
        <div><dt>Type</dt><dd>{{ db.typeLabels[crop.type] }}</dd></div>
        {% if crop.edible == true %}<div><dt>Edible</dt><dd>Yes{% if crop.edible_parts and crop.edible_parts.length %} · {{ crop.edible_parts | join(", ") }}{% endif %}</dd></div>
        {% elif crop.edible == false %}<div><dt>Edible</dt><dd>Not recorded as a food plant</dd></div>{% endif %}
        {% if crop.toxic == true %}<div><dt>Poisonous use recorded</dt><dd>{% if crop.toxic_parts and crop.toxic_parts.length %}Named part{{ 's' if crop.toxic_parts.length != 1 else '' }}: {{ crop.toxic_parts | join(", ") }}.{% else %}A source records a poisonous use; the plant part is not specified in that record.{% endif %}</dd></div>{% endif %}
        {% if crop.sun %}<div><dt>Sun</dt><dd>{{ crop.sun | label }}</dd></div>{% endif %}
        {% if crop.water %}<div><dt>Water</dt><dd>{{ crop.water | label }}</dd></div>{% endif %}
        {% if crop.temperature and crop.temperature.frost_tender %}<div><dt>Frost</dt><dd>Frost-tender</dd></div>{% endif %}
        {% if crop.days_to_first_harvest %}<div><dt>To first harvest</dt><dd>{{ crop.days_to_first_harvest | range(" days") }}</dd></div>{% endif %}
        {% if crop.propagation %}<div><dt>Grown from</dt><dd>{{ crop.propagation | join(", ") | replace("-", " ") }}</dd></div>{% endif %}
        {% if crop.size and crop.size.height_cm %}<div><dt>Height</dt><dd>{{ crop.size.height_cm }} cm</dd></div>{% endif %}
        {% if crop.size and crop.size.spread_cm %}<div><dt>Spread</dt><dd>{{ crop.size.spread_cm }} cm</dd></div>{% endif %}
        {% if crop.size and crop.size.row_spacing_cm %}<div><dt>Row spacing</dt><dd>{{ crop.size.row_spacing_cm }} cm</dd></div>{% endif %}
        {% if crop.sowing_method %}<div class="wide"><dt>Sowing</dt><dd>{{ crop.sowing_method }}</dd></div>{% endif %}
        {% if crop.rescue and crop.rescue.growing_degree_days_as_recorded %}<div class="wide"><dt>"Growing degree days" in old OpenFarm</dt><dd>{{ crop.rescue.growing_degree_days_as_recorded }} <small>(as recorded – often looks like days to harvest; unverified)</small></dd></div>{% endif %}
      </dl>
      {% if crop.temperature and crop.temperature.note %}<p class="small">{{ crop.temperature.note }}</p>{% endif %}
    </section>
    {% if crop.perennial %}{% set pe = crop.perennial %}
    <section class="side-card">
      <h3>Perennial &amp; fruit facts</h3>
      <dl class="kv">
        {% if pe.years_to_first_crop is defined %}<div><dt>First crop</dt><dd>{{ pe.years_to_first_crop | range(" yr after planting") }}</dd></div>{% endif %}
        {% if pe.productive_years %}<div><dt>Productive for</dt><dd>{{ pe.productive_years }}{% if pe.productive_years | string | first in "0123456789" %} years{% endif %}</dd></div>{% endif %}
        {% if pe.pollination %}<div><dt>Pollination</dt><dd>{{ pe.pollination | label }}</dd></div>{% endif %}
        {% if pe.chill_hours %}<div><dt>Chill hours</dt><dd>{{ pe.chill_hours | range(" h") }} <small>below 7 °C</small></dd></div>{% endif %}
      </dl>
      {% if pe.pollination_notes %}<p class="small">{{ pe.pollination_notes }}</p>{% endif %}
      {% if pe.chill_note %}<p class="small">{{ pe.chill_note }}</p>{% endif %}
      {% if pe.first_crop_note %}<p class="small">{{ pe.first_crop_note }}</p>{% endif %}
      {% if pe.replant_note %}<p class="small">{{ pe.replant_note }}</p>{% endif %}
      {% if pe.rootstocks %}<h4>Rootstocks</h4><ul class="small">{% for r in pe.rootstocks %}<li><strong>{{ r.name }}</strong> ({{ r.vigour | label }}){% if r.notes %} – {{ r.notes }}{% endif %}</li>{% endfor %}</ul>{% endif %}
    </section>
    {% endif %}
    {% if crop.seed_saving or crop.seedImage %}
    <section class="side-card">
      <h3>Seeds</h3>
      {% set ss = crop.seed_saving %}{% set vs = false %}{% set simg = crop.seedImage %}{% include "seeds.njk" %}
    </section>
    {% endif %}
    {% include "weather.njk" %}
  </aside>
</div>
