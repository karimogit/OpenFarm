---
layout: base.njk
title: Growing guides matched to your climate region
pageScripts: [home.js]
---
<section class="hero">
  <h1>What can I grow here, and when?</h1>
  <p class="lead">{{ site.tagline }}</p>
  <p class="stats">{{ db.stats.crops }} crops · {{ db.stats.varieties }} varieties · {{ db.stats.guides }} climate guides · {{ db.stats.regions }} climate regions covering the whole planet</p>
</section>

<div class="layout">
  <div class="col-main">
    <section id="where" class="card where" data-pagefind-ignore>
      <h2>1 · Pick a location</h2>
      <form id="search" class="row" autocomplete="off">
        <input id="q" type="search" placeholder="Search a place, e.g. Utrecht or Umeå" aria-label="Place search">
        <button type="submit">Search</button>
        <button type="button" id="geo" title="Use my location" aria-label="Use my location">📍</button>
      </form>
      <ul id="results" class="results" hidden></ul>
      <form id="coords" class="row small">
        <label>Lat <input id="lat" type="number" step="any" min="-90" max="90" required></label>
        <label>Lon <input id="lon" type="number" step="any" min="-180" max="180" required></label>
        <button type="submit">Go</button>
        <label class="toggle"><input type="checkbox" id="overlay"> Show climate map</label>
      </form>
      <div id="map" aria-label="Map – click to choose a location"></div>
      <p class="hint">Or click anywhere on the map. Try:
        <a href="?lat=52.09&lon=5.12" data-demo>Utrecht (NL)</a> ·
        <a href="?lat=63.83&lon=20.26" data-demo>Umeå (SE)</a> ·
        <a href="?lat=37.39&lon=-5.98" data-demo>Seville (ES)</a> ·
        <a href="?lat=39.74&lon=-104.99" data-demo>Denver (US)</a> ·
        <a href="?lat=13.75&lon=100.50" data-demo>Bangkok (TH)</a> ·
        <a href="?lat=-37.81&lon=144.96" data-demo>Melbourne (AU)</a></p>
    </section>

    <section id="climate" class="card" hidden>
      <h2>2 · Your climate region</h2>
      <div id="climate-box"></div>
    </section>

    <section id="matches" class="card" hidden>
      <h2>3 · Guides for your climate region</h2>
      <div id="match-list"></div>
    </section>
  </div>

  <aside class="col-side">
    {% include "weather.njk" %}
    <section class="side-card">
      <h3>Browse crops</h3>
      <ul class="chips">
        {% for t in db.types %}<li><a href="{{ '/crops/' | url }}#{{ t.slug }}">{{ t.label }} <small>{{ t.crops.length }}</small></a></li>{% endfor %}
      </ul>
    </section>
    <section class="side-card">
      <h3>Climate regions</h3>
      <ul class="region-list">
        {% for r in db.regions %}<li><a href="{{ ('/regions/' + r.slug + '/') | url }}"><span class="swatch sm" style="background:{{ r.color }}"></span>{{ r.name }}</a></li>{% endfor %}
      </ul>
    </section>
  </aside>
</div>

<section class="card about">
  <h2>Open by design</h2>
  <p>Every guide is a plain text file on GitHub, so anyone can suggest improvements and every change is tracked.
    Guides are written per crop and per climate region, and every fact links to its source.
    <a href="{{ '/contribute/' | url }}">How it works and how to help →</a></p>
</section>

<link rel="stylesheet" href="{{ '/assets/vendor/leaflet/leaflet.css' | url }}">
<script src="{{ '/assets/vendor/leaflet/leaflet.js' | url }}"></script>
