---
layout: base.njk
title: Growing guides matched to your climate region
pageScripts: [home.js]
---
<section class="hero home-hero">
  <h1>{{ site.short }}</h1>
  <p class="lead">{{ site.tagline }}</p>
</section>

<div class="layout home-layout">
  <div class="col-main">
    <section id="matches" class="card">
      <h2>Guides for your climate region</h2>
      <div id="match-list">
        <p class="muted" data-pagefind-ignore>Search for your location to see the growing guides that fit your climate.
          Or <a href="{{ '/crops/' | url }}">browse all {{ db.stats.crops }} crops</a>.</p>
      </div>
    </section>

    <section class="card">
      <h2>Browse crops</h2>
      <p class="small muted">{{ db.stats.crops }} crops · {{ db.stats.varieties }} varieties · {{ db.stats.guides }} guides</p>
      <ul class="chips">
        {% for t in db.types %}<li><a class="type-chip t-{{ t.slug }}" href="{{ ('/crops/type/' + t.slug + '/') | url }}">{{ t.label }} <small>{{ t.crops.length }}</small></a></li>{% endfor %}
      </ul>
    </section>
    <section class="card">
      <h2>Browse climate regions</h2>
      <p class="small muted">{{ db.stats.regions }} climate regions cover every place on Earth.</p>
      <ul class="region-list two-col">
        {% for r in db.regions %}<li><a href="{{ ('/regions/' + r.slug + '/') | url }}"><span class="swatch sm" style="background:{{ r.color }}"></span>{{ r.name }}</a></li>{% endfor %}
      </ul>
    </section>

  </div>

  <aside class="col-side details-panel" data-pagefind-ignore>
    <details id="details-panel" open>
      <summary id="details-summary"><span>Set your location to see your climate region and hardiness zone</span><span class="chg">change</span></summary>
      <section id="where" class="side-card where">
        <h3>Your location</h3>
        <form id="search" class="search-main" autocomplete="off" role="search">
          <input id="q" type="search" placeholder="Search a town or region…" aria-label="Find your location">
          <button type="submit">Find</button>
        </form>
        <ul id="results" class="results" hidden></ul>
        <p><button type="button" id="geo" class="secondary small">Use my current location</button></p>
        <div id="map" aria-label="Map – click to choose a location"></div>
        <details class="small coords-details">
          <summary>Coordinates · climate map</summary>
          <form id="coords" class="row">
            <label>Lat <input id="lat" type="number" step="any" min="-90" max="90" required></label>
            <label>Lon <input id="lon" type="number" step="any" min="-180" max="180" required></label>
            <button type="submit">Go</button>
            <label class="toggle"><input type="checkbox" id="overlay"> <span id="overlay-label">Show climate map</span></label>
          </form>
        </details>
        <p class="credit">Stored only in this browser.</p>
      </section>
      {% include "your-climate.njk" %}
      <div id="climate-box" hidden></div>
      {% include "weather.njk" %}
      <section class="side-card profile-card" data-profile-summary>
        <h3>Your profile</h3>
        <p class="small" data-profile-counts>No favourites yet — use the heart on any crop, variety, guide or tool.</p>
        <p class="row"><a class="button small" href="{{ '/profile/' | url }}">My Profile</a>
          <button type="button" class="secondary small" data-profile-export>Export</button></p>
        <p class="credit">Stored only in this browser – nothing is sent anywhere.</p>
      </section>
    </details>
  </aside>
</div>

<link rel="stylesheet" href="{{ '/assets/vendor/leaflet/leaflet.css' | url }}">
<script src="{{ '/assets/vendor/leaflet/leaflet.js' | url }}"></script>
